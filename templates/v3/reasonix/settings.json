{
  "hooks": {
    "SessionStart": [
      {
        "command": "bash .reasonix/hooks/aegis-session-start.sh",
        "description": "Aegis 入口：注入约束摘要（动手前必读的四条）",
        "timeout": 5000
      }
    ],
    "PreToolUse": [
      {
        "match": "write|edit|multi_edit",
        "command": "bash .reasonix/hooks/aegis-guard-write.sh",
        "description": "Aegis 拦截：NOTES.md 未建时不许写文件",
        "timeout": 5000
      },
      {
        "match": "bash",
        "command": "bash .reasonix/hooks/aegis-guard-bash.sh",
        "description": "Aegis 拦截：不许在主干上直接提交",
        "timeout": 5000
      }
    ],
    "Stop": [
      {
        "command": "bash .reasonix/hooks/aegis-stop-check.sh",
        "description": "Aegis 出口提醒：NOTES.md 是否更新（Reasonix 的 Stop 不可阻塞，只能提醒）",
        "timeout": 10000
      }
    ]
  }
}
